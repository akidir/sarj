        // (storage event — farklı sekme/pencereden gelen değişiklikleri yakalar)
        // ══════════════════════════════════════
        window.addEventListener('storage', function (e) {
            if (e.key === 'proje_sema_v1') {
                renderKolon();
            }
        });
    </script>
</head>
<body>
    <h1>Kolon Hesaplama</h1>
