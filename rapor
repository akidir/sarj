// ─────────── ANA KURAL MOTORU ───────────
function onDegerlendirmeYap(sema) {
  const g   = sema.guc || {};
  const vis = sema.visibility || {};

  // Güç değerleri
  const eskiKurulu  = Number(g.eskiKurulu)      || 0;
  const eskiTalep   = Number(g.eskiTalep)       || 0;
  const ilaveKurulu = Number(g.ilaveKurulu)     || 0;
  const ilaveTalep  = Number(g.ilaveTalep)      || 0;
  const yeniKurulu  = eskiKurulu  + ilaveKurulu;
  const yeniTalep   = eskiTalep   + ilaveTalep;
  const yapiEskiKG  = Number(g.yapiEskiKGPuant) || 0;
  const yapiEskiTG  = Math.round(yapiEskiKG * 0.8);
  const yapiYeniTG  = yapiEskiTG + ilaveTalep;
  const istekCosQ   = Number(sema.istekCosQ)    || 0.8;

  // Sigorta aktif/pasif (Kural D1)
  const sigKolonAktif    = !!(vis.sigKolonVisible || vis.tmsKolonVisible);
  const sigSayacCikisAktif = !!vis.sigSayacCikisVisible;

  // Parse
  const kofre        = { ham: sema.kofre || '', deger: Number((sema.kofre||'').match(/(\d+)/)?.[1] || 0) };
  const kolonKablo   = _parseKablo(sema.kolonKablo);
  const sigKolonT    = sema.kolonSigortaTip;
  const sigKolonRaw  = sigKolonT === 'TMŞ' ? sema.tmsKolonText : sema.sigKolonText;
  const sigKolon     = sigKolonAktif ? _parseSig(sigKolonRaw) : null;
  const sayac        = _parseSayac(sema.sayacTip, sema.sayacTrafo);
  const sigSayacG    = _parseSig(sema.sigSayacGiris);
  const roleSayacG   = _parseRole(sema.roleSayacGirisA, sema.roleSayacGirisB);
  const sigSayacC    = sigSayacCikisAktif ? _parseSig(sema.sigSayacCikis) : null;
  const linyeDtMev   = _parseKablo(sema.linyeDtMevcut);
  const linyeYukMev  = _parseKablo(sema.linyeYukMevcut);
  const sigMev       = _parseSig(sema.sigMevcut);
  const roleMev      = _parseRole(sema.roleMevcutA, sema.roleMevcutB);
  const yukMev       = _parseYuk(sema.yukMevcut);
  const linyeDtIst   = _parseKablo(sema.linyeDtIstek);
  const linyeYukIst  = _parseKablo(sema.linyeYukIstek);
  const sigIst       = _parseSig(sema.sigIstek);
  const roleIst      = _parseRole(sema.roleIstekA, sema.roleIstekB);
  const yukIst       = _parseYuk(sema.yukIstek);

  // Sayaç faz beklentisi
  const sayacTrifaz  = sayac.tipi === 'Trifaze' || sayac.tipi === 'X5';
  const beklSayacFaz = sayacTrifaz ? 'trifaz' : 'monofaz';

  // Akım hesapları
  const yapiYeniYukA    = yapiYeniTG  > 0 ? yapiYeniTG  / (1.73 * 380 * 0.8) : 0;
  const yeniTalepYukA   = yeniTalep   > 0 ? yeniTalep   / (1.73 * 380 * 0.8) : 0;
  const eskiTalepYukA_mono  = eskiTalep  > 0 ? eskiTalep  / 220 : 0;
  const eskiTalepYukA_tri   = eskiTalep  > 0 ? eskiTalep  / (1.73 * 380 * 0.8) : 0;
  const ilaveTalepYukA_mono = ilaveTalep > 0 ? ilaveTalep / 220 : 0;
  const ilaveTalepYukA_tri  = ilaveTalep > 0 ? ilaveTalep / (1.73 * 380 * 0.8) : 0;
  const yukMevYukA_mono     = yukMev.guc > 0 ? yukMev.guc / 220 : 0;
  const yukMevYukA_tri      = yukMev.guc > 0 ? yukMev.guc / (1.73 * 380 * 0.8) : 0;
  const yukIstYukA_mono     = yukIst.guc > 0 ? yukIst.guc / 220 : 0;
  const yukIstYukA_tri      = yukIst.guc > 0 ? yukIst.guc / (1.73 * 380 * istekCosQ) : 0;

  // DT mevcut / istek hat faz seçimi
  const linyeDtMevFaz = beklSayacFaz; // mevcut kolon her zaman sayaç fazına uyar
  const linyeDtIstFaz = beklSayacFaz === 'monofaz' ? 'monofaz' : (yukIst.faz || 'trifaz');
  const linyeYukMevFaz = beklSayacFaz === 'monofaz' ? 'monofaz' : (yukMev.faz || 'trifaz');
  const linyeYukIstFaz = linyeDtIstFaz;

  // ─────────── 1. KABLOLAR ───────────
  // G2: Ana Kolon Kablosu kesiti
  const kolonKabloYukA = yapiYeniTG > 0 ? yapiYeniTG / (1.73 * 380 * 0.8) : 0;
  const kolonKabloFazSonuc = _rfaz(_kabloFaz(kolonKablo), 'trifaz',
    'Not2: Ana kolon kablosu için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.');
  const kolonKabloKesitSonuc = kolonKablo && kolonKabloYukA > 0
    ? _r(_kabloKesitiSonucu(kolonKabloYukA, kolonKablo.kesit, kolonKablo.damar_sayi),
        'Not19: Ana kolon kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const kolonKabloHtml = kolonKabloFazSonuc.includes('✅') && kolonKabloKesitSonuc.includes('✅')
    ? '<span class="od-uygun">✅ Uygun</span>'
    : !kolonKabloFazSonuc.includes('✅') ? kolonKabloFazSonuc : kolonKabloKesitSonuc;

  // G6: Mevcut DT kolon kablosu kesiti
  const mevDtFaz = _kabloFaz(linyeDtMev);
  const mevDtIsMonofaz = linyeDtMevFaz === 'monofaz';
  const mevDtYukA = mevDtIsMonofaz ? eskiTalepYukA_mono : eskiTalepYukA_tri;
  const mevDtFazSonuc = _rfaz(mevDtFaz, linyeDtMevFaz,
    'Not9: Mevcut DT kolon kablosu için seçilen faz değeri UYGUN DEĞİLDİR.');
  const mevDtKesitSonuc = linyeDtMev && mevDtYukA > 0
    ? _r(_kabloKesitiSonucu(mevDtYukA, linyeDtMev.kesit, linyeDtMev.damar_sayi),
        'Not29: Mevcut DT kolon kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const mevDtSonuc = mevDtFazSonuc.includes('✅') && mevDtKesitSonuc.includes('✅')
