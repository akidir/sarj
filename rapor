function _parseSig(txt) {
  if (!txt || !txt.trim()) return null;
  const raw  = String(txt).trim();
  const faz  = raw.includes('3x') ? '3x' : '1x';
  const akim = Number(raw.match(/(\d+)\s*A/i)?.[1] || 0);
  return { faz, akim, ham: raw };
}
function _parseKablo(txt) {
  if (!txt || !txt.trim()) return null;
  const raw = String(txt).replace(/\s+/g,' ').trim();
  const damarSayi = Number(raw.match(/^(\d)/)?.[1] || 0);
  const kesitMatch = raw.match(/\d+x\s*([0-9]+(?:[.,][0-9]+)?)/i);
  const kesit = Number((kesitMatch?.[1] || '0').replace(',','.'));
  return { damar_sayi: damarSayi, kesit, ham: raw };
}
function _parseRole(txtA, txtB) {
  const rawA = String(txtA||'').trim();
  const rawB = String(txtB||'').trim();
  const tip  = rawA.includes('30mA') ? '30mA' : '300mA';
  const faz  = rawB.includes('4x') ? '4x' : '2x';
  const akim = Number(rawB.match(/(\d+)\s*A/i)?.[1] || 0);
  return { tip, faz, akim };
}
function _parseSayac(tipTxt, trafoTxt) {
  const ilk = String(tipTxt||'').split(' ')[0];
  let tipi = 'Trifaze';
  if (ilk==='1x10') tipi='Monofaze';
  else if (ilk==='X5') tipi='X5';
  const rawT = String(trafoTxt||'').trim();
  const pay   = rawT ? Number(rawT.split('/')[0]) || 0 : 0;
  const payda = rawT ? Number(rawT.split('/')[1]) || 5 : 5;
  return { tipi, pay, payda, trafoTam: rawT };
}
function _parseYuk(txt) {
  const raw   = String(txt||'').trim();
  const parts = raw.split('-').map(s=>s.trim());
  const faz   = (parts[1]||'').toLowerCase().includes('trifaz') ? 'trifaz' : 'monofaz';
  const guc   = Number(raw.match(/(\d+)\s*W/i)?.[1] || 0);
  return { faz, guc };
}

function _kabloFaz(kablo) {
  if (!kablo) return null;
  return kablo.damar_sayi <= 3 ? 'monofaz' : 'trifaz';
}
function _sigFaz(sig) {
  if (!sig) return null;
  return sig.faz === '3x' ? 'trifaz' : 'monofaz';
}
function _roleFaz(role) {
  if (!role) return null;
  return role.faz === '4x' ? 'trifaz' : 'monofaz';
}

// Sigorta seçim sonucu: 'uygun' | 'potansiyel' | 'uygunsuz' | null
function _sigortaSecimiSonucu(yukAkimi, seciliAkim) {
  if (!yukAkimi || !seciliAkim) return null;
  const sRev = [...SIGORTA_LIST].reverse();
  const floorSigorta = sRev.find(s => s <= yukAkimi) ?? null;
  const ceilIdx  = SIGORTA_LIST.findIndex(s => s > yukAkimi);
  const ceilSigorta = ceilIdx >= 0 ? SIGORTA_LIST[ceilIdx] : null;

  if (floorSigorta !== null && yukAkimi <= floorSigorta * 1.05) {
    const fi    = SIGORTA_LIST.indexOf(floorSigorta);
    const birUst = fi+1 < SIGORTA_LIST.length ? SIGORTA_LIST[fi+1] : null;
    const ikiUst = fi+2 < SIGORTA_LIST.length ? SIGORTA_LIST[fi+2] : null;
    if (seciliAkim === floorSigorta)   return 'potansiyel';
    if (seciliAkim === birUst)         return 'uygun';
    if (seciliAkim === ikiUst)         return 'potansiyel';
    return 'uygunsuz';
  } else {
    if (!ceilSigorta) return 'uygunsuz';
    const ci    = SIGORTA_LIST.indexOf(ceilSigorta);
    const birUst = ci+1 < SIGORTA_LIST.length ? SIGORTA_LIST[ci+1] : null;
    if (seciliAkim === ceilSigorta) return 'uygun';
    if (seciliAkim === birUst)      return 'potansiyel';
    return 'uygunsuz';
  }
}

// Kablo kesiti seçim sonucu: 'uygun' | 'uygunsuz' | null
function _kabloKesitiSonucu(yukAkimi, seciliKesit, damarSayisi) {
  if (!yukAkimi || !seciliKesit) return null;
  const table = damarSayisi <= 3 ? NYY_2DAMAR : NYY_4DAMAR;
  const kesitler = Object.keys(table).map(Number).sort((a,b)=>a-b);
  const acceptable = [];
  for (const k of kesitler) {
    if (table[k] > yukAkimi) { acceptable.push(k); if (acceptable.length === 2) break; }
  }
  return acceptable.includes(Number(seciliKesit)) ? 'uygun' : 'uygunsuz';
}

// Trafo seçim sonucu: 'uygun' | 'potansiyel' | 'uygunsuz' | null
function _trafoSecimSonucu(yukAkimi, seciliPay) {
  if (!yukAkimi || !seciliPay) return null;
  const trafoOrani = yukAkimi / 5;
  const tRev = [...TRAFO_PAYLARI].reverse();
  const floorTrafo = tRev.find(t => t <= trafoOrani) ?? null;
  const ceilIdx = TRAFO_PAYLARI.findIndex(t => t > trafoOrani);
  const ceilTrafo = ceilIdx >= 0 ? TRAFO_PAYLARI[ceilIdx] : null;

  if (floorTrafo !== null && trafoOrani <= floorTrafo * 1.05) {
    const fi    = TRAFO_PAYLARI.indexOf(floorTrafo);
    const birUst = fi+1 < TRAFO_PAYLARI.length ? TRAFO_PAYLARI[fi+1] : null;
    if (seciliPay === floorTrafo) return 'potansiyel';
    if (seciliPay === birUst)     return 'uygun';
    return 'uygunsuz';
  } else {
    if (!ceilTrafo) return 'uygunsuz';
    if (seciliPay === ceilTrafo) return 'uygun';
    return 'uygunsuz';
  }
}

// Sonuç render yardımcıları
function _r(sonuc, uygunsuzNot, potNot) {
  if (sonuc === null)           return '<span class="od-veri-yok">Veri Bulunamadı</span>';
  if (sonuc === 'uygun')        return '<span class="od-uygun">✅ Uygun</span>';
