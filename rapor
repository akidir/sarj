      : !fazS.includes('✅') ? fazS : degerS;
  }

  // Kural 4b + G5: Sayaç giriş sigortası
  const beklSayacFazSig = yeniKurulu > 5000 ? 'trifaz' : 'monofaz';
  const sayacGirisYukA  = yeniTalep > 0 ? yeniTalep / (1.73 * 380 * 0.8) : 0;
  const sigSayacGFazS   = _rfaz(_sigFaz(sigSayacG), beklSayacFazSig,
    'Not5: Sayaç giriş sigortası için seçilen faz değeri UYGUN DEĞİLDİR.');
  const sigSayacGDegerS = sigSayacG && yeniTalep > 0
    ? _r(_sigortaSecimiSonucu(sayacGirisYukA, sigSayacG.akim),
        'Not25: Sayaç giriş sigortası için seçilen sigorta akım değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const sigSayacGSonuc = sigSayacGFazS.includes('✅') && sigSayacGDegerS.includes('✅')
    ? '<span class="od-uygun">✅ Uygun</span>'
    : !sigSayacGFazS.includes('✅') ? sigSayacGFazS : sigSayacGDegerS;

  // Sayaç çıkış sigortası (Kural D1: pasif ise Not28)
  let sigSayacCSonuc;
  if (!sigSayacCikisAktif) {
    sigSayacCSonuc = '<span class="od-potansiyel">⚠️ Pasif</span><div class="od-not">Not28: Sayaç çıkış sigortasının olmaması dağıtım şirketi kabul kriterleriyle uyumsuzluk gösterebilir.</div>';
  } else if (sigSayacC) {
    const fazS   = _rfaz(_sigFaz(sigSayacC), beklSayacFazSig,
      'Not7: Sayaç çıkış sigortası için seçilen faz değeri UYGUN DEĞİLDİR.');
    const degerS = yeniTalep > 0
      ? _r(_sigortaSecimiSonucu(sayacGirisYukA, sigSayacC.akim),
          'Not27: Sayaç çıkış sigortası için seçilen faz değeri UYGUN DEĞİLDİR.')
      : '<span class="od-veri-yok">Veri Bulunamadı</span>';
    sigSayacCSonuc = fazS.includes('✅') && degerS.includes('✅')
      ? '<span class="od-uygun">✅ Uygun</span>'
      : !fazS.includes('✅') ? fazS : degerS;
  } else {
    sigSayacCSonuc = '<span class="od-veri-yok">Veri Bulunamadı</span>';
  }

  // Kural 6 + G7: Mevcut kolon sigortası
  const mevIsMonofazSig = beklSayacFaz === 'monofaz';
  const mevKolonYukA    = mevIsMonofazSig ? eskiTalepYukA_mono : eskiTalepYukA_tri;
  const sigMevFazS      = _rfaz(_sigFaz(sigMev), beklSayacFaz,
    'Not10: Mevcut DT sigortası için seçilen faz değeri UYGUN DEĞİLDİR.');
  const sigMevDegerS    = sigMev && eskiTalep > 0
    ? _r(_sigortaSecimiSonucu(mevKolonYukA, sigMev.akim),
        'Not30: Mevcut DT sigortası için seçilen sigorta akım değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const sigMevSonuc = sigMevFazS.includes('✅') && sigMevDegerS.includes('✅')
    ? '<span class="od-uygun">✅ Uygun</span>'
    : !sigMevFazS.includes('✅') ? sigMevFazS : sigMevDegerS;

  // Kural 9 + G10: İstek kolon sigortası
  const istIsMonofazSig = linyeDtIstFaz === 'monofaz';
  const istKolonYukA    = istIsMonofazSig ? ilaveTalepYukA_mono : ilaveTalepYukA_tri;
  const sigIstFazS      = _rfaz(_sigFaz(sigIst), linyeDtIstFaz,
    'Not14: İstek DT sigortası için seçilen faz değeri UYGUN DEĞİLDİR.');
  const sigIstDegerS    = sigIst && ilaveTalep > 0
    ? _r(_sigortaSecimiSonucu(istKolonYukA, sigIst.akim),
        'Not34: İstek DT sigortası için seçilen sigorta akım değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const sigIstSonuc = sigIstFazS.includes('✅') && sigIstDegerS.includes('✅')
    ? '<span class="od-uygun">✅ Uygun</span>'
    : !sigIstFazS.includes('✅') ? sigIstFazS : sigIstDegerS;

  const kesicilerBolum = _bolumHtml(2, 'Kesiciler', [
    { baslik: 'Kofre',                                  sonuc: kofreSonuc },
    { baslik: 'Ana Kolon Kesicileri (AT)',               sonuc: kolonSigSonuc },
    { baslik: 'Sayaç Giriş Sigortası',                  sonuc: sigSayacGSonuc },
    { baslik: 'Sayaç Çıkış Sigortası',                  sonuc: sigSayacCSonuc },
    { baslik: 'Mevcut Kolon Sigortası',                 sonuc: sigMevSonuc },
    { baslik: 'İstek Kolon Sigortası',                  sonuc: sigIstSonuc },
  ]);

  // ─────────── 3. RÖLELER ───────────
  // Kural 6b + G7: Mevcut kolon rölesi
  const roleMevFazS   = _rfaz(_roleFaz(roleMev), beklSayacFaz,
    'Not11: Mevcut DT rölesi için seçilen faz değeri UYGUN DEĞİLDİR.');
  const roleMevDegerS = roleMev && eskiTalep > 0
    ? _r(_sigortaSecimiSonucu(mevKolonYukA, roleMev.akim),
        'Not31: Mevcut DT rölesi için seçilen röle akım değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const roleMevTipS   = roleMev
    ? (roleMev.tip === '30mA' ? '<span class="od-uygun">✅ Uygun</span>'
