    if (sonra.includes('Akım yönünden uygun değildir')) return false;
    return null;
  }

  // Kural 38: En uzun I1, I2, I3
  {
    const gdUzun = sema.gdEnUzunHtml || '';
    if (gdUzun) {
      const i1ok = gdAkimUygunMu(gdUzun, 'I1');
      const i2ok = gdAkimUygunMu(gdUzun, 'I2');
      const i3ok = gdAkimUygunMu(gdUzun, 'I3');
      kural.push({no:'38.1', grup:'6. AKIM HESAPLARI', baslik:'En Uzun I1 Akım',
        durum: i1ok === null ? 'atla' : (i1ok ? 'uygun' : 'uygunsuz'),
        not: i1ok === false ? 'En uzun hat I1 akımı kolon kablosu akım taşıma kapasitesini aşıyor. Kesit büyütülmelidir.' : ''
      });
      kural.push({no:'38.2', grup:'6. AKIM HESAPLARI', baslik:'En Uzun I2 Akım',
        durum: i2ok === null ? 'atla' : (i2ok ? 'uygun' : 'uygunsuz'),
        not: i2ok === false ? 'En uzun hat I2 akımı DT kolon kablosu akım taşıma kapasitesini aşıyor. Kesit büyütülmelidir.' : ''
      });
      kural.push({no:'38.3', grup:'6. AKIM HESAPLARI', baslik:'En Uzun I3 Akım',
        durum: i3ok === null ? 'atla' : (i3ok ? 'uygun' : 'uygunsuz'),
        not: i3ok === false ? 'En uzun hat I3 akımı yük linye kablosu akım taşıma kapasitesini aşıyor. Kesit büyütülmelidir.' : ''
      });
    } else {
      kural.push({no:'38.1', grup:'6. AKIM HESAPLARI', baslik:'En Uzun I1/I2/I3', durum:'atla', not:'Akım hesabı verisi bulunamadı.'});
    }
  }

  // Kural 39: En güçlü I1, I2, I3
  {
    const gdGuclu = sema.gdEnGucluHtml || '';
    if (gdGuclu) {
      const i1ok = gdAkimUygunMu(gdGuclu, 'I1');
      const i2ok = gdAkimUygunMu(gdGuclu, 'I2');
      const i3ok = gdAkimUygunMu(gdGuclu, 'I3');
      kural.push({no:'39.1', grup:'6. AKIM HESAPLARI', baslik:'En Güçlü I1 Akım',
        durum: i1ok === null ? 'atla' : (i1ok ? 'uygun' : 'uygunsuz'),
        not: i1ok === false ? 'En güçlü hat I1 akımı kolon kablosu akım taşıma kapasitesini aşıyor. Kesit büyütülmelidir.' : ''
      });
      kural.push({no:'39.2', grup:'6. AKIM HESAPLARI', baslik:'En Güçlü I2 Akım',
        durum: i2ok === null ? 'atla' : (i2ok ? 'uygun' : 'uygunsuz'),
        not: i2ok === false ? 'En güçlü hat I2 akımı DT kolon kablosu akım taşıma kapasitesini aşıyor. Kesit büyütülmelidir.' : ''
      });
      kural.push({no:'39.3', grup:'6. AKIM HESAPLARI', baslik:'En Güçlü I3 Akım',
        durum: i3ok === null ? 'atla' : (i3ok ? 'uygun' : 'uygunsuz'),
        not: i3ok === false ? 'En güçlü hat I3 akımı yük linye kablosu akım taşıma kapasitesini aşıyor. Kesit büyütülmelidir.' : ''
      });
    } else {
      kural.push({no:'39.1', grup:'6. AKIM HESAPLARI', baslik:'En Güçlü I1/I2/I3', durum:'atla', not:'Akım hesabı verisi bulunamadı.'});
    }
  }

  // ── HTML OLUŞTUR ──────────────────────────────────────
  const gruplar = {};
  kural.forEach(function(k) {
    if (!gruplar[k.grup]) gruplar[k.grup] = [];
    gruplar[k.grup].push(k);
  });

  let html = '<div class="od-baslik">🔍 Ön Değerlendirme Sonuçları</div>';

  Object.keys(gruplar).forEach(function(grupAdi) {
    const kurallar = gruplar[grupAdi];
    const tumUygun = kurallar.every(k => k.durum === 'uygun' || k.durum === 'atla');
    const herhangiUygunsuz = kurallar.some(k => k.durum === 'uygunsuz');
    const herhangiPotansiyel = !herhangiUygunsuz && kurallar.some(k => k.durum === 'potansiyel');
    let ozet = tumUygun ? '✅ UYGUN' : (herhangiUygunsuz ? '❌ UYGUNSUZ' : '⚠️ POTANSİYEL UYGUNSUZLUK');
    html += '<div class="od-grup">';
    html += '<div class="od-grup-baslik">' + grupAdi + '<span>' + ozet + '</span></div>';
    html += '<div class="od-kural-listesi">';
    kurallar.forEach(function(k) {
      html += odKuralSatiri(k.no, k.baslik, k.durum, k.not);
    });
    html += '</div></div>';
  });

  sonucEl.innerHTML = html;
}

