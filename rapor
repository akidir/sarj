    : !mevDtFazSonuc.includes('✅') ? mevDtFazSonuc : mevDtKesitSonuc;

  // G8: Mevcut linye yük kablosu kesiti
  const mevYukFaz = _kabloFaz(linyeYukMev);
  const mevYukIsMonofaz = linyeYukMevFaz === 'monofaz';
  const mevYukYukA = mevYukIsMonofaz ? yukMevYukA_mono : yukMevYukA_tri;
  const mevYukFazSonuc = _rfaz(mevYukFaz, linyeYukMevFaz,
    'Not12: Mevcut DT linye kablosu için seçilen faz değeri UYGUN DEĞİLDİR.');
  const mevYukKesitSonuc = linyeYukMev && mevYukYukA > 0
    ? _r(_kabloKesitiSonucu(mevYukYukA, linyeYukMev.kesit, linyeYukMev.damar_sayi),
        'Not32: Mevcut DT linye kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const mevYukSonuc = mevYukFazSonuc.includes('✅') && mevYukKesitSonuc.includes('✅')
    ? '<span class="od-uygun">✅ Uygun</span>'
    : !mevYukFazSonuc.includes('✅') ? mevYukFazSonuc : mevYukKesitSonuc;

  // G9: İstek DT kolon kablosu kesiti
  const istDtFaz = _kabloFaz(linyeDtIst);
  const istDtIsMonofaz = linyeDtIstFaz === 'monofaz';
  const istDtYukA = istDtIsMonofaz ? ilaveTalepYukA_mono : ilaveTalepYukA_tri;
  const istDtFazSonuc = _rfaz(istDtFaz, linyeDtIstFaz,
    'Not13: İstek DT linye kablosu için seçilen faz değeri UYGUN DEĞİLDİR.');
  const istDtKesitSonuc = linyeDtIst && istDtYukA > 0
    ? _r(_kabloKesitiSonucu(istDtYukA, linyeDtIst.kesit, linyeDtIst.damar_sayi),
        'Not33: İstek DT kolon kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const istDtSonuc = istDtFazSonuc.includes('✅') && istDtKesitSonuc.includes('✅')
    ? '<span class="od-uygun">✅ Uygun</span>'
    : !istDtFazSonuc.includes('✅') ? istDtFazSonuc : istDtKesitSonuc;

  // G11: İstek linye yük kablosu kesiti
  const istYukFaz = _kabloFaz(linyeYukIst);
  const istYukIsMonofaz = linyeYukIstFaz === 'monofaz';
  const istYukYukA = istYukIsMonofaz ? yukIstYukA_mono : yukIstYukA_tri;
  const istYukFazSonuc = _rfaz(istYukFaz, linyeYukIstFaz,
