    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const roleMevUygun  = roleMevFazS.includes('✅') && roleMevDegerS.includes('✅') && roleMevTipS.includes('✅');
  const roleMevSonuc  = roleMevUygun ? '<span class="od-uygun">✅ Uygun</span>'
    : !roleMevFazS.includes('✅') ? roleMevFazS
    : !roleMevTipS.includes('✅') ? roleMevTipS : roleMevDegerS;

  // Kural 9b + G10: İstek kolon rölesi
  const roleIstFazS   = _rfaz(_roleFaz(roleIst), linyeDtIstFaz,
    'Not15: İstek DT rölesi için seçilen faz değeri UYGUN DEĞİLDİR.');
  const roleIstDegerS = roleIst && ilaveTalep > 0
    ? _r(_sigortaSecimiSonucu(istKolonYukA, roleIst.akim),
        'Not35: İstek DT rölesi için seçilen röle akım değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const roleIstTipS   = roleIst
    ? (roleIst.tip === '30mA' ? '<span class="od-uygun">✅ Uygun</span>'
      : '<span class="od-uygunsuz">❌ Uygunsuz</span><div class="od-not">Not39: İstek DT rölesi için röle tipi UYGUN DEĞİLDİR. (30mA olmalı)</div>')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const roleIstUygun  = roleIstFazS.includes('✅') && roleIstDegerS.includes('✅') && roleIstTipS.includes('✅');
  const roleIstSonuc  = roleIstUygun ? '<span class="od-uygun">✅ Uygun</span>'
    : !roleIstFazS.includes('✅') ? roleIstFazS
    : !roleIstTipS.includes('✅') ? roleIstTipS : roleIstDegerS;

  // Kural 4b + G5: Sayaç giriş rölesi
  const roleSayacGFazS   = _rfaz(_roleFaz(roleSayacG), beklSayacFazSig,
    'Not6: Sayaç giriş rölesi için seçilen faz değeri UYGUN DEĞİLDİR.');
  const roleSayacGDegerS = roleSayacG && yeniTalep > 0
    ? _r(_sigortaSecimiSonucu(sayacGirisYukA, roleSayacG.akim),
        'Not26: Sayaç giriş rölesi için seçilen röle akım değeri UYGUN DEĞİLDİR.')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const roleSayacGTipS   = roleSayacG
    ? (roleSayacG.tip === '300mA' ? '<span class="od-uygun">✅ Uygun</span>'
      : '<span class="od-uygunsuz">❌ Uygunsuz</span><div class="od-not">Not37: Sayaç giriş rölesi için röle tipi UYGUN DEĞİLDİR. (300mA olmalı)</div>')
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';
  const roleSayacGUygun  = roleSayacGFazS.includes('✅') && roleSayacGDegerS.includes('✅') && roleSayacGTipS.includes('✅');
  const roleSayacGSonuc  = roleSayacGUygun ? '<span class="od-uygun">✅ Uygun</span>'
    : !roleSayacGFazS.includes('✅') ? roleSayacGFazS
    : !roleSayacGTipS.includes('✅') ? roleSayacGTipS : roleSayacGDegerS;

  const rolelerBolum = _bolumHtml(3, 'Röleler', [
    { baslik: 'Mevcut Kolon Rölesi',      sonuc: roleMevSonuc },
    { baslik: 'İstek Kolon Rölesi',       sonuc: roleIstSonuc },
    { baslik: 'Sayaç Giriş Rölesi',       sonuc: roleSayacGSonuc },
  ]);

  // ─────────── 4. SAYAÇ ───────────
  // Kural 4a: Sayaç tipi
  const beklSayacTip = yeniKurulu > 5000 ? 'trifaz' : 'monofaz';
  let sayacTipSonuc;
  if (!sema.sayacTip) {
    sayacTipSonuc = '<span class="od-veri-yok">Veri Bulunamadı</span>';
  } else {
    const gercekTip = sayac.tipi === 'Monofaze' ? 'monofaz'
      : (sayac.tipi === 'Trifaze' || sayac.tipi === 'X5') ? 'trifaz' : null;
    sayacTipSonuc = _rfaz(gercekTip, beklSayacTip,
      'Not4: Sayaç için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.');
  }
  // Kural 4c + G4: X5 eşiği
  const x5Esik = yeniTalepYukA >= 100;
  if (x5Esik && sayac.tipi !== 'X5') {
    sayacTipSonuc = '<span class="od-uygunsuz">❌ Uygunsuz</span><div class="od-not">Not8 / Not22: Seçilen sayaç tipi yeni talep güç değerine göre UYGUN DEĞİLDİR. (X5 olmalı)</div>';
  }

  // G4: Akım trafo oranı
  let trafoSonuc = '<span class="od-veri-yok">Veri Bulunamadı</span>';
  if (sayac.tipi === 'X5') {
    if (!sayac.pay) {
      trafoSonuc = '<span class="od-veri-yok">Trafo oranı girilmemiş</span>';
    } else {
      const ts = _trafoSecimSonucu(yeniTalepYukA, sayac.pay);
      trafoSonuc = _r(ts,
        'Not24: Seçilen akım trafo oranı yeni talep güç değerine göre UYGUN DEĞİLDİR.',
        'Not23: Seçilen akım trafo oranı, dağıtım şirketi kabul kriterleriyle uyumsuzluk gösterebilir.');
    }
  } else {
    trafoSonuc = '<span class="od-veri-yok">X5 sayaç değil — uygulanmaz</span>';
  }

  const sayacBolum = _bolumHtml(4, 'Sayaç', [
    { baslik: 'Sayaç Tipi',         sonuc: sayacTipSonuc },
    { baslik: 'Akım Trafo Oranı',   sonuc: trafoSonuc },
  ]);

  // ─────────── 5. GERİLİM DÜŞÜMÜ HESAPLARI ───────────
  const gdU = sema.gdEnUzun;
  const gdG = sema.gdEnGuclu;
  const gdUzunSonuc = !gdU ? '<span class="od-veri-yok">Veri Bulunamadı (Elektrik Şeması\'nı yenileyin)</span>'
    : gdU.etopOk
      ? `<span class="od-uygun">✅ Uygun</span><div class="od-not">%${gdU.etop.toFixed(2)} &lt; %${GD_SINIR}</div>`
      : `<span class="od-uygunsuz">❌ Uygunsuz</span><div class="od-not">Not40: Gerilim düşümü hesabı (en uzun) için %etop değeri UYGUN DEĞİLDİR. (%${gdU.etop.toFixed(2)} &gt; %${GD_SINIR})</div>`;
  const gdGucluSonuc = !gdG ? '<span class="od-veri-yok">Veri Bulunamadı (Elektrik Şeması\'nı yenileyin)</span>'
    : gdG.etopOk
      ? `<span class="od-uygun">✅ Uygun</span><div class="od-not">%${gdG.etop.toFixed(2)} &lt; %${GD_SINIR}</div>`
      : `<span class="od-uygunsuz">❌ Uygunsuz</span><div class="od-not">Not41: Gerilim düşümü hesabı (en güçlü) için %etop değeri UYGUN DEĞİLDİR. (%${gdG.etop.toFixed(2)} &gt; %${GD_SINIR})</div>`;

  const gdBolum = _bolumHtml(5, 'Gerilim Düşümü Hesapları', [
    { baslik: 'GD En Uzun (%etop)',   sonuc: gdUzunSonuc },
    { baslik: 'GD En Güçlü (%etop)', sonuc: gdGucluSonuc },
  ]);

  // ─────────── 6. AKIM HESAPLARI ───────────
  function _gdAkimSatir(gdData, akimNo, notNo) {
    if (!gdData) return '<span class="od-veri-yok">Veri Bulunamadı</span>';
    const ok = gdData[akimNo + 'ok'];
    if (ok === null || ok === undefined) return '<span class="od-veri-yok">Veri Bulunamadı</span>';
    return ok
      ? '<span class="od-uygun">✅ Uygun</span>'
      : `<span class="od-uygunsuz">❌ Uygunsuz</span><div class="od-not">${notNo}: GD için belirlenen kablo değeri UYGUN DEĞİLDİR.</div>`;
  }

  const akimBolum = _bolumHtml(6, 'Akım Hesapları', [
    { baslik: 'GD En Uzun — I1',   sonuc: _gdAkimSatir(gdU, 'I1', 'Not42') },
    { baslik: 'GD En Uzun — I2',   sonuc: _gdAkimSatir(gdU, 'I2', 'Not43') },
    { baslik: 'GD En Uzun — I3',   sonuc: _gdAkimSatir(gdU, 'I3', 'Not44') },
    { baslik: 'GD En Güçlü — I1',  sonuc: _gdAkimSatir(gdG, 'I1', 'Not45') },
    { baslik: 'GD En Güçlü — I2',  sonuc: _gdAkimSatir(gdG, 'I2', 'Not46') },
    { baslik: 'GD En Güçlü — I3',  sonuc: _gdAkimSatir(gdG, 'I3', 'Not47') },
  ]);

  return `<div class="od-panel">
    <div class="od-baslik">🔍 Ön Değerlendirme Sonuçları</div>
    ${kablolarBolum}${kesicilerBolum}${rolelerBolum}${sayacBolum}${gdBolum}${akimBolum}
