    + (potNot ? '<div class="od-not">' + potNot + '</div>' : '');
  return '<span class="od-uygunsuz">❌ Uygunsuz</span>'
    + (uygunsuzNot ? '<div class="od-not">' + uygunsuzNot + '</div>' : '');
}
function _rfaz(gercek, beklenen, uygunsuzNot) {
  if (!gercek) return '<span class="od-veri-yok">Veri Bulunamadı</span>';
  if (gercek === beklenen) return '<span class="od-uygun">✅ Uygun</span>';
  return '<span class="od-uygunsuz">❌ Uygunsuz</span>'
    + (uygunsuzNot ? '<div class="od-not">' + uygunsuzNot + '</div>' : '');
}

function _bolumHtml(no, baslik, satirlar) {
