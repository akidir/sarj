    ? '<span class="od-uygun">✅ Uygun</span>'
    : !istYukFazSonuc.includes('✅') ? istYukFazSonuc : istYukKesitSonuc;

  const kablolarBolum = _bolumHtml(1, 'Kablolar', [
    { baslik: 'Ana Kolon Kablosu',            sonuc: kolonKabloHtml },
    { baslik: 'Mevcut Kolon Kablosu',         sonuc: mevDtSonuc },
    { baslik: 'Mevcut Linye Kablosu',         sonuc: mevYukSonuc },
    { baslik: 'İstek Kolon Kablosu',          sonuc: istDtSonuc },
    { baslik: 'İstek Linye Kablosu',          sonuc: istYukSonuc },
  ]);

  // ─────────── 2. KESİCİLER ───────────
  // Kural 1: Kofre her zaman trifaz → kofre panelinde faz yok; bilgi alanına not
  const kofreSonuc = kofre.deger > 0 && yapiYeniTG > 0
    ? (function() {
        const s = _sigortaSecimiSonucu(yapiYeniYukA, kofre.deger);
        return _r(s,
          'Not17: Kofre için seçilen sigorta akım değeri UYGUN DEĞİLDİR.',
          'Not18: Kofre için seçilen sigorta akım değeri, dağıtım şirketi kabul kriterleriyle uyumsuzluk gösterebilir.');
      })()
    : '<span class="od-veri-yok">Veri Bulunamadı</span>';

  // Kural 3 + G3: Ana kolon kesicileri faz + değer
  let kolonSigSonuc = '<span class="od-veri-yok">Pasif / Veri Yok</span>';
  if (sigKolonAktif && sigKolon) {
    const fazS   = _rfaz(_sigFaz(sigKolon), 'trifaz',
      'Not3: AT giriş sigortası için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.');
    const degerS = yapiYeniTG > 0
      ? _r(_sigortaSecimiSonucu(yapiYeniYukA, sigKolon.akim),
          'Not20: AT giriş sigortası için seçilen sigorta akım değeri UYGUN DEĞİLDİR.',
          'Not21: AT giriş sigortası için seçilen sigorta akım değeri, dağıtım şirketi kabul kriterleriyle uyumsuzluk gösterebilir.')
      : '<span class="od-veri-yok">Veri Bulunamadı</span>';
    kolonSigSonuc = fazS.includes('✅') && degerS.includes('✅')
