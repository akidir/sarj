      not: k6ok ? '' : 'Mevcut DT linye kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 7: İstek kolon kablosu faz
  if (linyeDtIstek) {
    let k7ok;
    if (sayacMonofaz) {
      k7ok = linyeDtIstek.monofaz;
    } else {
      if (yukIstek) k7ok = (yukIstek.trifaz ? linyeDtIstek.trifaz : linyeDtIstek.monofaz);
      else k7ok = linyeDtIstek.trifaz;
    }
    kural.push({no:7, grup:'1. KABLOLAR', baslik:'İstek DT Linye Kablosu Faz',
      durum: k7ok ? 'uygun' : 'uygunsuz',
      not: k7ok ? '' : 'İstek DT linye kablosu için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 8: İstek kolon kablosu kesit
  if (linyeDtIstek) {
    const istekTrifaz = yukIstek ? yukIstek.trifaz : true;
    const akim = istekTrifaz ? yukAkimTrifaz(ilaveTalep) : yukAkimMonofaz(ilaveTalep);
    const uygunKesitler = odUygunKesitler(linyeDtIstek.tip, linyeDtIstek.damar, akim);
    const k8ok = uygunKesitler.slice(0, 2).includes(linyeDtIstek.kesit);
    kural.push({no:8, grup:'1. KABLOLAR', baslik:'İstek DT Kolon Kablosu Kesit',
      durum: k8ok ? 'uygun' : 'uygunsuz',
      not: k8ok ? '' : 'İstek DT kolon kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 9: İstek linye kablosu faz
  if (linyeYukIstek) {
    let k9ok;
    if (sayacMonofaz) {
      k9ok = linyeYukIstek.monofaz;
    } else {
      if (yukIstek) k9ok = (yukIstek.trifaz ? linyeYukIstek.trifaz : linyeYukIstek.monofaz);
      else k9ok = linyeYukIstek.trifaz;
    }
    kural.push({no:9, grup:'1. KABLOLAR', baslik:'İstek DT Linye Kablosu Faz',
      durum: k9ok ? 'uygun' : 'uygunsuz',
      not: k9ok ? '' : 'İstek DT linye kablosu için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 10: İstek linye kablosu kesit
  if (linyeYukIstek) {
    const istekTrifaz = yukIstek ? yukIstek.trifaz : true;
    const akim = istekTrifaz ? yukAkimTrifazCosQ(ilaveTalep, istekCosQ) : yukAkimMonofaz(ilaveTalep);
    const uygunKesitler = odUygunKesitler(linyeYukIstek.tip, linyeYukIstek.damar, akim);
    const k10ok = uygunKesitler.slice(0, 2).includes(linyeYukIstek.kesit);
    kural.push({no:10, grup:'1. KABLOLAR', baslik:'İstek DT Linye Kablosu Kesit',
      durum: k10ok ? 'uygun' : 'uygunsuz',
      not: k10ok ? '' : 'İstek DT linye kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // ── 2. KESİCİLER ─────────────────────────────────────

  // Kural 11: Kofre - her zaman trifaz
  if (kofre) {
