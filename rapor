function onDegerlendirmeYap(sema, yapi) {
  const sonucEl = document.getElementById('on-degerlendirme-sonuc');
  if (!sonucEl) return;
  sonucEl.style.display = 'block';

  const g = sema.guc || {};
  const eskiKurulu   = parseFloat(g.eskiKurulu)   || 0;
  const eskiTalep    = parseFloat(g.eskiTalep)    || 0;
  const ilaveKurulu  = parseFloat(g.ilaveKurulu)  || 0;
  const ilaveTalep   = parseFloat(g.ilaveTalep)   || 0;
  const yapiEskiKG   = parseFloat(g.yapiEskiKGPuant) || 0;
  const yeniKurulu   = eskiKurulu + ilaveKurulu;
  const yeniTalep    = eskiTalep  + ilaveTalep;
  const yapiYeniTG   = Math.round(yapiEskiKG * 0.8) + ilaveTalep;
  const istekCosQ    = parseFloat(sema.istekCosQ) || 0.8;

  // Yük fazı tespiti
  const yukMevcut = odParseYuk(sema.yukMevcut);
  const yukIstek  = odParseYuk(sema.yukIstek);

  // Sayaç
  const sayac = odParseSayac(sema.sayacTip, sema.sayacTrafo);
  const sayacMonofaz = sayac.tip === 'Monofaze';
  const sayacTrifaz  = sayac.tip === 'Trifaze';
  const sayacX5      = sayac.tip === 'X5';

  // Kablo verileri
  const kabloKolon        = odParseKablo(sema.kolonKablo);
  const linyeDtMevcut     = odParseKablo(sema.linyeDtMevcut);
  const linyeYukMevcut    = odParseKablo(sema.linyeYukMevcut);
  const linyeDtIstek      = odParseKablo(sema.linyeDtIstek);
  const linyeYukIstek     = odParseKablo(sema.linyeYukIstek);

  // Sigorta verileri
  const sigKolonTip  = sema.kolonSigortaTip || 'Yok';
  const sigKolonAktif = sigKolonTip !== 'Yok';
  const sigKolonTxt  = sigKolonTip === 'TMŞ' ? sema.tmsKolonText : sema.sigKolonText;
  const sigKolon     = odParseSigorta(sigKolonTxt);
  const kofre        = odParseSigorta(sema.kofre);
  const sigSayacGiris = odParseSigorta(sema.sigSayacGiris);
  const sigSayacCikis = odParseSigorta(sema.sigSayacCikis);
  const sigSayacCikisAktif = !!(sema.visibility && sema.visibility.sigSayacCikisVisible);
  const sigMevcut    = odParseSigorta(sema.sigMevcut);
  const sigIstek     = odParseSigorta(sema.sigIstek);

  // Röle verileri
  const roleMevcut     = odParseRole(sema.roleMevcutA, sema.roleMevcutB);
  const roleIstek      = odParseRole(sema.roleIstekA, sema.roleIstekB);
  const roleSayacGiris = odParseRole(sema.roleSayacGirisA, sema.roleSayacGirisB);

  // Akım hesaplama yardımcıları
  function yukAkimTrifaz(guc) { return guc / (1.73 * 380 * 0.8); }
  function yukAkimMonofaz(guc) { return guc / 220; }
  function yukAkimTrifazCosQ(guc, cosQ) { return guc / (1.73 * 380 * (cosQ || 0.8)); }

  const kural = [];

  // ── 1. KABLOLAR ──────────────────────────────────────

  // Kural 1: Ana Kolon Kablosu - her zaman trifaz
  if (kabloKolon) {
    const k1ok = kabloKolon.trifaz;
    kural.push({no:1, grup:'1. KABLOLAR', baslik:'Ana Kolon Kablosu Faz',
      durum: k1ok ? 'uygun' : 'uygunsuz',
      not: k1ok ? '' : 'Ana kolon kablosu için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 2: Ana Kolon Kablosu kesit
  if (kabloKolon) {
    const akim = yukAkimTrifaz(yapiYeniTG);
    const uygunKesitler = odUygunKesitler(kabloKolon.tip, kabloKolon.damar, akim);
    const k2ok = uygunKesitler.slice(0, 2).includes(kabloKolon.kesit);
    kural.push({no:2, grup:'1. KABLOLAR', baslik:'Ana Kolon Kablosu Kesit',
      durum: k2ok ? 'uygun' : 'uygunsuz',
      not: k2ok ? '' : 'Ana kolon kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 3: Mevcut kolon kablosu faz
  if (linyeDtMevcut) {
    let k3ok;
    if (sayacMonofaz) k3ok = linyeDtMevcut.monofaz;
    else k3ok = linyeDtMevcut.trifaz;
    kural.push({no:3, grup:'1. KABLOLAR', baslik:'Mevcut DT Kolon Kablosu Faz',
      durum: k3ok ? 'uygun' : 'uygunsuz',
      not: k3ok ? '' : 'Mevcut DT kolon kablosu için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 4: Mevcut kolon kablosu kesit
  if (linyeDtMevcut) {
    const akim = linyeDtMevcut.trifaz ? yukAkimTrifaz(eskiTalep) : yukAkimMonofaz(eskiTalep);
    const uygunKesitler = odUygunKesitler(linyeDtMevcut.tip, linyeDtMevcut.damar, akim);
    const k4ok = uygunKesitler.slice(0, 2).includes(linyeDtMevcut.kesit);
    kural.push({no:4, grup:'1. KABLOLAR', baslik:'Mevcut DT Kolon Kablosu Kesit',
      durum: k4ok ? 'uygun' : 'uygunsuz',
      not: k4ok ? '' : 'Mevcut DT kolon kablosu için seçilen kablo kesit değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 5: Mevcut linye kablosu faz
  if (linyeYukMevcut) {
    let k5ok;
    if (sayacMonofaz) {
      k5ok = linyeYukMevcut.monofaz;
    } else {
      // trifaz/x5 → mevcut yükün fazına göre
      if (yukMevcut) k5ok = (yukMevcut.trifaz ? linyeYukMevcut.trifaz : linyeYukMevcut.monofaz);
      else k5ok = true;
    }
    kural.push({no:5, grup:'1. KABLOLAR', baslik:'Mevcut DT Linye Kablosu Faz',
      durum: k5ok ? 'uygun' : 'uygunsuz',
      not: k5ok ? '' : 'Mevcut DT linye kablosu için seçilen faz değeri UYGUN DEĞİLDİR. Projenin onaydan dönme riskine karşı değerleri kontrol etmeniz önerilir.'
    });
  }

  // Kural 6: Mevcut linye kablosu kesit
  if (linyeYukMevcut && yukMevcut) {
    const akim = yukMevcut.trifaz ? yukAkimTrifaz(yukMevcut.guc || eskiKurulu) : yukAkimMonofaz(yukMevcut.guc || eskiKurulu);
    const uygunKesitler = odUygunKesitler(linyeYukMevcut.tip, linyeYukMevcut.damar, akim);
